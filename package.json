{
  "name": "ninna-ui",
  "version": "0.6.0",
  "private": true,
  "description": "A React-first, framework-agnostic UI system with design tokens, primitives, and layouts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninna-ui/ninna-ui.git"
  },
  "type": "module",
  "license": "MIT",
  "author": "Ninna-UI Team",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint typecheck",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "safelist": "node packages/core/scripts/generate-safelist.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "check-exports": "publint packages/core && publint packages/utils && publint packages/react-internal && publint packages/primitives && publint packages/feedback && publint packages/layout && publint packages/forms && publint packages/overlays && publint packages/navigation && publint packages/data-display && publint packages/code-block && publint packages/cli",
    "check-pack": "node scripts/check-pack.js",
    "check-internal-deps": "node scripts/check-internal-deps.js",
    "check-template-versions": "node scripts/check-template-versions.js",
    "size": "size-limit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@ninna-ui/eslint-config": "workspace:*",
    "@ninna-ui/test-config": "workspace:*",
    "@sa11y/vitest": "^8.0.28",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "9.39.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "size-limit": "^12.1.0",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "undici": "^8.10.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}
